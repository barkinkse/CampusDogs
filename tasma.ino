const uint8_t* const icons[6] = {icon0, icon1, icon2, icon3, icon4, icon5};

int activeCount() {
  int count = 0;
  for (int i = 0; i < 6; ++i) if (currentStatus & statusBits[i]) ++count;
  return count;
}

int firstActive() {
  for (int i = 0; i < 6; ++i) if (currentStatus & statusBits[i]) return i;
  return -1;
}

int nextActive(int after) {
  for (int step = 1; step <= 6; ++step) {
    int i = (after + step) % 6;
    if (currentStatus & statusBits[i]) return i;
  }
  return -1;
}

void centeredText(const char* text, int16_t y) {
  int16_t x1, y1;
  uint16_t w, h;
  display.getTextBounds(text, 0, y, &x1, &y1, &w, &h);
  display.setCursor((SCREEN_WIDTH - (int)w) / 2, y);
  display.print(text);
}

void updateOLED() {
  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);
  display.setTextSize(1);
  display.setTextWrap(false);
  display.setCursor(0, 0);
  display.print("PAWLINK");
  display.setCursor(86, 0);
  display.print(DOG_ID);
  // * : hafizadan yuklenen, henuz bu acilista dogrulanmamis veri
  if (awaitingSync) display.drawChar(77, 0, '*', SSD1306_WHITE, SSD1306_BLACK, 1);
  display.drawFastHLine(0, 10, 128, SSD1306_WHITE);

  if (currentStatus == 0 || currentScreen < 0) {
    display.setTextSize(2);
    centeredText("NORMAL", 20);
    display.setTextSize(1);
    centeredText("OZEL DURUM YOK", 45);
  } else {
    display.drawBitmap(48, 12, icons[currentScreen], 32, 32, SSD1306_WHITE);
    centeredText(statusNames[currentScreen], 45);
    int count = activeCount();
    if (count > 1) {
      int rank = 0;
      for (int i = 0; i < 6; ++i) {
        if (currentStatus & statusBits[i]) {
          if (i == currentScreen) break;
          ++rank;
        }
      }
      int totalWidth = count * 9 - 3;
      int startX = (128 - totalWidth) / 2;
      for (int j = 0; j < count; ++j) {
        int x = startX + j * 9;
        if (j == rank) display.fillRoundRect(x, 58, 6, 4, 2, SSD1306_WHITE);
        else display.drawRoundRect(x, 58, 6, 4, 2, SSD1306_WHITE);
      }
    }
  }
  display.display();
}

class StatusCallbacks : public BLECharacteristicCallbacks {
  void onWrite(BLECharacteristic* characteristic) override {
    String value = characteristic->getValue();
    if (value.length() == 1) {
      uint8_t incoming = (uint8_t)value[0];
      if (incoming <= 63) {
        pendingStatus = incoming;
        statusReceived = true;
      }
    }
  }
};

class ServerCallbacks : public BLEServerCallbacks {
  void onDisconnect(BLEServer* server) override {
    BLEDevice::startAdvertising();
  }
};

void setup() {
  Serial.begin(115200);
  delay(1000);
  Wire.begin(21, 22);
  if (!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    Serial.println("OLED HATASI!");
    while (true) delay(1000);
  }
  preferences.begin("pawlink", false);
  currentStatus = preferences.getUChar("status", 0);
  if (currentStatus > 63) currentStatus = 0;
  currentScreen = firstActive();
  lastScreenChange = millis();
  Serial.print("KAYITLI DURUM: ");
  Serial.println(currentStatus);
  updateOLED();

  BLEDevice::init(DEVICE_NAME);
  bleServer = BLEDevice::createServer();
  bleServer->setCallbacks(new ServerCallbacks());
  BLEService* service = bleServer->createService(SERVICE_UUID);
  statusCharacteristic = service->createCharacteristic(
    STATUS_UUID, BLECharacteristic::PROPERTY_WRITE
  );
  statusCharacteristic->setCallbacks(new StatusCallbacks());
  service->start();

  BLEAdvertisementData advData;
  advData.setFlags(0x06);
  // iPhone uygulamasinin gorecegi BLE reklam adi.
  advData.setName(DEVICE_NAME);
  String manufacturerData;
  manufacturerData += (char)0xFF;
  manufacturerData += (char)0xFF;
  manufacturerData += DOG_ID;
  advData.setManufacturerData(manufacturerData);
  BLEAdvertising* advertising = BLEDevice::getAdvertising();
  advertising->setAdvertisementData(advData);
  advertising->start();
  Serial.print("BLE REKLAM ADI: ");
  Serial.println(DEVICE_NAME);
  Serial.println("PAWLINK COLLAR V4 READY");
}

void loop() {
  if (statusReceived) {
    uint8_t newStatus = pendingStatus;
    statusReceived = false;
    Serial.print("BLE DURUM ALINDI: ");
    Serial.println(newStatus);

    bool statusChanged = (newStatus != currentStatus);
    bool wasAwaitingSync = awaitingSync;
    awaitingSync = false;

    if (statusChanged) {
      currentStatus = newStatus;
      currentScreen = firstActive();
      lastScreenChange = millis();
      preferences.putUChar("status", currentStatus);
      Serial.println("DURUM NVS BELLEGE KAYDEDILDI");
    }

    // Ayni durum tekrar geldiginde ikon dongusu sifirlanmaz.
    if (statusChanged || wasAwaitingSync) updateOLED();
  }

  if (currentStatus != 0 && activeCount() > 1) {
    unsigned long duration = (currentScreen == firstActive()) ? 8000UL : 4000UL;
    if (millis() - lastScreenChange >= duration) {
      currentScreen = nextActive(currentScreen);
      lastScreenChange = millis();
      updateOLED();
    }
  }
  delay(20);
}
